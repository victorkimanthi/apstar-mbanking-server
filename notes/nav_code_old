                        SaccoTrans.JournalInsert(JTemplate,JBatch,DocNo,PDate,AcctType::Credit,AccNo,COPYSTR(LoanProduct."Product Description"+' Interest',1,50),BalAccType::"G/L Account",
                                      '',-UpfrontInterest,ExtDoc,LoanNo,TransType::"Interest Paid",Dim1,Dim2,SystCreated,Loans."Member Name");



                        IF LoanProduct."Advantage Loan" THEN BEGIN
                            Loans."Loan Interest Repayment" := ROUND(LoanProduct."Weekly Interest Rate"/100*Loans."Approved Amount");
