                        Loans.Status:=Loans.Status::Approved;
                        Loans."Disbursement Account No":=MobileLoan."Account No";// loanAccountNum;
                        Loans."Disbursement Date":=TODAY;
                        Loans."Issued Date":=TODAY;
                        Loans.Installments:=LoanProduct."Ordinary Default Intallments";
                        Loans."Repayment Start Date" := CALCDATE(FORMAT(Loans.Installments)+'M',Loans."Issued Date");
                        Loans."Repayment Frequency":=LoanProduct."Repayment Frequency";
                        IF Loans."Non-Salaried" THEN
                            Loans."Repayment Start Date" := CALCDATE('30D',Loans."Issued Date");
                        Loans."Installment Period":=LoanProduct."Installment Repayment Interval";
                        IF LoanProduct."Advantage Loan" THEN BEGIN
                            Loans."Repayment Start Date" := CALCDATE('1W',Loans."Issued Date");
                            Loans."Repayment Frequency":=Loans."Repayment Frequency"::Weekly;
                            Loans."Expected Date of Completion" := CALCDATE(FORMAT(Loans.Installments)+'W',Loans."Issued Date");
                            Loans."Next Interest Date" := CALCDATE('1W+1D',Loans."Issued Date");
                        END;
                        Loans."Interest Calculation Method":=LoanProduct."Interest Calculation Method";
                        Loans."Loan Span" := Loans."Loan Span"::"Short Term";
                        Loans."Approval Date" := TODAY;
                        Loans."Global Dimension 1 Code":=SavAcc."Global Dimension 1 Code";
                        Loans."Global Dimension 1 Code":=SavAcc."Global Dimension 1 Code";
                        Loans."Captured By":=UPPERCASE(USERID);
                        Loans.Source:=Loans.Source::BANKING;
                        Loans."Repayment Frequency":=LoanProduct."Repayment Frequency";
                        Loans.Interest:=LoanProduct."Interest Rate (Min.)";
                        IF LoanProduct."Appraisal Parameter Type"=LoanProduct."Appraisal Parameter Type"::Dividends THEN
                           Loans.Interest := GetDividendMultiplier(Loans."Application Date",1) * 12;
                        IF LoanProduct."Advantage Loan" THEN
                        Loans.Interest:=LoanProduct."Weekly Interest Rate";
                        Loans."Recovery Mode":=Loans."Recovery Mode"::Salary;
                        IF LoanProduct."Repay Mode" = LoanProduct."Repay Mode"::Dividend THEN
                          Loans."Recovery Mode":=Loans."Recovery Mode"::Dividend;

                        Loans.VALIDATE("Approved Amount");

                        IF LoanProduct."Advantage Loan" THEN BEGIN

                            Loans.Repayment:=ROUND((LoanProduct."Weekly Interest Rate"/100) / (1 - POWER((1 + (LoanProduct."Weekly Interest Rate"/100)),- Loans.Installments)) *
                            Loans."Approved Amount",1,'>');

                            Loans."Loan Interest Repayment":=ROUND(Loans."Approved Amount" / 100 * LoanProduct."Weekly Interest Rate",0.05,'>');
                            Loans."Loan Principle Repayment":=Loans.Repayment-Loans."Loan Interest Repayment";
                        END;

                        //Loans."Loan Interest Repayment":=(MobileLoan.Amount * ((prodFact."Interest Rate (Min.)"/12) / 100));
                        //Loans."Loan Principle Repayment":=MobileLoan.Amount;
                        //Loans.Repayment:=Loans."Loan Interest Repayment"+Loans."Loan Principle Repayment";
                        Loans.INSERT(TRUE);
                        LoanNo := Loans."Loan No.";
                    END;

