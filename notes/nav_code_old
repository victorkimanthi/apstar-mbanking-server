                            END;
                        END;

                        AccNo := VendorAccount;
                        ExtDoc := Loans."Disbursement Account No";
                        LoanNo := '';
                        TransType := TransType::" ";

                        SaccoTrans.JournalInsert(JTemplate,JBatch,DocNo,PDate,AcctType::Vendor,AccNo,COPYSTR(LoanProduct."Product Description"+' Disbursement Commission',1,50),BalAccType::"G/L Account",
                                      '',-VendorCommission,ExtDoc,LoanNo,TransType,Dim1,Dim2,SystCreated,Loans."Member Name");

                        MobileLoan.Remarks:='Successful';
                        MobileLoan."Approved Amount":=Loans."Approved Amount";
                        MobileLoan.Status:=MobileLoan.Status::Successful;
                        MobileLoan.Posted:=TRUE;
                        MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                        MobileLoan.Message:=msg;
                        MobileLoan."Loan No.":=Loans."Loan No.";
                        MobileLoan.MODIFY;


                        Loans.Posted:=TRUE;
                        Loans.MODIFY;
                        LoanNo:=Loans."Loan No.";


                        SaccoTrans.PostJournal(JTemplate,JBatch);

                        Loans.GET(LoanNo);
                        Loans.CALCFIELDS("Outstanding Balance","Outstanding Interest");

                        IF (LoanProduct."Advantage Loan") OR (LoanProduct."Product ID" = '417') THEN BEGIN
                            msg:='Dear '+FirstName(Loans."Member Name")+
                            ', your '+LoanProduct."USSD Product Name"+' of KES '+FORMAT(MobileLoan."Requested Amount")+' has been approved and disbursed to your savings account. Current Loan Balance is '+
                            FORMAT(Loans."Outstanding Balance"+Loans."Outstanding Interest");

                        END
                        ELSE BEGIN
                            IF Loans."Non-Salaried" AND (LoanProduct."Appraisal Parameter Type"<>LoanProduct."Appraisal Parameter Type"::Dividends) THEN BEGIN
                                msg:='Your Loan has been credited to your Fosa Savings Ac. Bal of KES '
                                +FORMAT(Loans."Outstanding Balance")+' is due on '+ddMMyyyy(CALCDATE('30D',Loans."Disbursement Date"))+'. To pay Dial *882# or use Ukulima Kash App';
                                 END
                            ELSE BEGIN
                                msg:='Dear '+FirstName(Loans."Member Name")+
                                ', your '+LoanProduct."USSD Product Name"+' of KES '+FORMAT(MobileLoan."Requested Amount")+' has been approved and disbursed to your savings account. Current Loan Balance is '+FORMAT(Loans."Outstanding Balance");
                            END;
                        END;
                        SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                    END;

                END;
            END;
         END;
    END;
END;

