                        AccNo := Loans."Loan Account";
                        IF Loans."Non-Salaried" THEN
                        LoanProduct."Product Description" := LoanProduct."USSD Product Name";
                        SaccoTrans.JournalInsert(JTemplate,JBatch,DocNo,PDate,AcctType::Credit,AccNo,COPYSTR(LoanProduct."Product Description"+' Disbursement',1,50),BalAccType::"G/L Account",
