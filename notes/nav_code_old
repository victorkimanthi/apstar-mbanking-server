              Response += '<CurrentCommitment>'+FORMAT(ROUND(Loans."Outstanding Balance"/LGCount))+'</CurrentCommitment>';

            Response += '</Security>';

        UNTIL LoanGuarantors.NEXT=0;
        Response+='</Loan>';
    END;
