        Response+='<Account>';
            Response+='<AccNo>'+SavAcc."No."+'</AccNo>';
            Response+='<AccName>'+SavAcc."Product Name"+'</AccName>';
        Response+='</Account>';
    UNTIL SavAcc.NEXT = 0;
    Response+='</SavAcc>';
END;


