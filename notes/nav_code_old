MobileLoan.RESET;
MobileLoan.SETRANGE("Entry No",EntryNo);
MobileLoan.SETRANGE(Status,MobileLoan.Status::"Pending Guarantors");
MobileLoan.SETRANGE(Posted,FALSE);
IF MobileLoan.FINDFIRST THEN BEGIN
    IF GetRemainingGuarantorCount(EntryNo) <= 0 THEN BEGIN
        UpdateAmountGuaranteed(EntryNo);
        IF MobileGuarantorsAccepted(EntryNo) THEN BEGIN
            MobileLoan.Status := MobileLoan.Status::Pending;
            MobileLoan.MODIFY;
        END;
    END;
END;

//Member not upto date in Deposit contribution. Amount Contributed in 180 Days is -7,800

MobileLoan.RESET;
MobileLoan.SETRANGE("Entry No",EntryNo);
MobileLoan.SETRANGE(Status,MobileLoan.Status::Pending);
MobileLoan.SETRANGE(Posted,FALSE);
IF MobileLoan.FINDFIRST THEN BEGIN
    Priority:=231;
    LoanProduct.GET(MobileLoan."Loan Product Type");
    SavAcc.RESET;
    SavAcc.SETRANGE("No.",MobileLoan."Account No");
    SavAcc.SETRANGE("Loan Disbursement Account",TRUE);
    IF SavAcc.FINDFIRST THEN BEGIN

        MemberNo := SavAcc."Member No.";
        Continue:=TRUE;

        Members.GET(MemberNo);


        IF Continue THEN BEGIN
            IF Members.Status <> Members.Status::Active THEN BEGIN
                msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, Your Account is not Active.';
                MobileLoan.Remarks:='Member is not Active';
                MobileLoan.Status:=MobileLoan.Status::Failed;
                MobileLoan.Posted:=TRUE;
                MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                MobileLoan.Message:=msg;
                SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                MobileLoan.MODIFY;
                Continue:=FALSE;
            END;
        END;



        IF Continue THEN BEGIN
            IF SavAcc.Status <> SavAcc.Status::Active THEN BEGIN

                msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, Your account is not Active.';
                MobileLoan.Remarks:='Account is not Active';
                MobileLoan.Status:=MobileLoan.Status::Failed;
                MobileLoan.Posted:=TRUE;
                MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                MobileLoan.Message:=msg;
                SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                MobileLoan.MODIFY;
                Continue:=FALSE;
            END;
        END;



        IF Continue THEN BEGIN

            LoanRec.RESET;
            LoanRec.SETRANGE("Member No.",Members."No.");
            LoanRec.SETRANGE(Recovered,TRUE);
            IF LoanRec.FIND('-') THEN BEGIN

                LoanRec.RESET;
                LoanRec.SETRANGE("Member No.",Members."No.");
                LoanRec.SETRANGE("Recovery Type",LoanRec."Recovery Type"::Dettachment);
                LoanRec.SETRANGE(Recovered,TRUE);
                IF NOT LoanRec.FIND('-') THEN BEGIN

                    msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, You have a loan previously recovered from guarantors.';
                    MobileLoan.Remarks:='Member has a loan previously recovered from guarantors';
                    MobileLoan.Status:=MobileLoan.Status::Failed;
                    MobileLoan.Posted:=TRUE;
                    MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                    MobileLoan.Message:=msg;
                    SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                    MobileLoan.MODIFY;
                    Continue:=FALSE;
                END;
            END;
        END;

        {
        //Check Membership Age
        IF Continue THEN BEGIN
            nDays:=0;

            IF SavAcc."Registration Date" <> 0D THEN
                nDays:=TODAY -SavAcc."Registration Date"
            ELSE
                nDays:=0;

            IF nDays<60 THEN BEGIN
                msg:='Your '+LoanProduct."Product Description"+' request has failed, Your account ('+MobileLoan."Account No"+') must be active for atleast 2 months.';
                MobileLoan.Remarks:='Account less than 2 months old';
                MobileLoan.Status:=MobileLoan.Status::Failed;
                MobileLoan.Posted:=TRUE;
                MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                MobileLoan.Message:=msg;
                SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),SavAcc."No.",FALSE);
                MobileLoan.MODIFY;
                Continue:=FALSE;
            END;
        END;
        }




        //Check Share Capital
        IF Continue THEN BEGIN
            IF NOT Members."Non-Member" THEN BEGIN
                ShareCap:=0;
                SavingsAccounts.RESET;
                SavingsAccounts.SETRANGE(SavingsAccounts."Member No.",MemberNo);
                SavingsAccounts.SETRANGE("Product Category",SavingsAccounts."Product Category"::"Share Capital"); // share capital account
                IF SavingsAccounts.FIND ('-') THEN BEGIN
                    SavingsAccounts.CALCFIELDS("Balance (LCY)");
                    ShareCap := SavingsAccounts."Balance (LCY)";
                END;

                IF (ShareCap <= 0) THEN BEGIN
                    msg:='Your '+LoanProduct."USSD Product Name"+' request was rejected, current share capital should be more than 0';
                    MobileLoan.Remarks:='Share capital should be more than 0';// ::' + FORMAT(membersShares);
                    MobileLoan.Status:=MobileLoan.Status::Failed;
                    MobileLoan.Posted:=TRUE;
                    MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                    MobileLoan.Message:=msg;
                    SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                    MobileLoan.MODIFY;
                    Continue:=FALSE;
                END;
            END;
        END;

        //  Classify members' loans

        IF Continue THEN BEGIN
            Loans.RESET;
            Loans.SETRANGE("Member No.",MemberNo);
            Loans.SETFILTER("Outstanding Balance",'>0');
            IF Loans.FINDSET THEN
              REPEAT
                LoansProcess.ClassifyLoan(Loans."Loan No.",TODAY,AmtArr,DaysArr,MonthArr);
              UNTIL Loans.NEXT = 0;
        END;

        //Check Defaulter
        IF Continue THEN BEGIN
            Loans.RESET;
            Loans.SETRANGE("Member No.",MemberNo);
            Loans.SETFILTER("Loans Category-SASRA",'%1|%2|%3',Loans."Loans Category-SASRA"::Substandard,
            Loans."Loans Category-SASRA"::Doubtful,Loans."Loans Category-SASRA"::Loss);
            Loans.SETFILTER("Outstanding Balance",'>0');
            IF Loans.FINDFIRST THEN BEGIN
                Product.GET(Loans."Loan Product Type");

                msg:=STRSUBSTNO(DefaulterSms,LoanProduct."USSD Product Name",Product."Product Description",Loans."Loans Category-SASRA");

                MobileLoan.Remarks:='Member has defaulted Loan No. '+Loans."Loan No."+' - '+Product."Product Description";
                MobileLoan.Status:=MobileLoan.Status::Failed;
                MobileLoan.Posted:=TRUE;
                MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                MobileLoan.Message:=msg;
                SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                MobileLoan.MODIFY;
                Continue:=FALSE;
            END;

           IF Continue THEN BEGIN
              Loans.RESET;
              Loans.SETRANGE("Member No.",MemberNo);
              Loans.SETRANGE(Defaulted,TRUE);
              Loans.SETFILTER("Outstanding Balance",'>0');
              IF Loans.FINDFIRST THEN BEGIN
                  Product.GET(Loans."Loan Product Type");
                  msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, You have defaulted '+Product."Product Description";
                  MobileLoan.Remarks:='Member has defaulted Loan No. '+Loans."Loan No."+' - '+Product."Product Description";
                  MobileLoan.Status:=MobileLoan.Status::Failed;
                  MobileLoan.Posted:=TRUE;
                  MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                  MobileLoan.Message:=msg;
                  SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                  MobileLoan.MODIFY;
                  Continue:=FALSE;
              END;
           END;
        END;

        IF Continue THEN BEGIN
            LoanProduct.RESET;
            LoanProduct.SETRANGE("Product ID",MobileLoan."Loan Product Type");
            LoanProduct.SETRANGE(AvailableOnMobile,TRUE);
            IF LoanProduct.FIND('-') THEN BEGIN

                IF LoanProduct."Micro Loan" THEN
                    MaxLoan:=GetMicroLoanQualifiedAmount(SavAcc."No.",LoanProduct."Product ID")
                ELSE IF LoanProduct."Appraisal Parameter Type" = LoanProduct."Appraisal Parameter Type"::Dividends THEN BEGIN

                    MaxLoan := GetDividendLoanQualifiedAmount(SavAcc."No.",LoanProduct."Product ID");



                    IF Continue THEN BEGIN
                        IF Members."Deposit Offset" THEN BEGIN
                            msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, Your deposits were used to offset your loan.';
                            MobileLoan.Remarks:='Deposit Used to Offset Loan';
                            MobileLoan.Status:=MobileLoan.Status::Failed;
                            MobileLoan.Posted:=TRUE;
                            MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                            MobileLoan.Message:=msg;
                            SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                            MobileLoan.MODIFY;
                            Continue:=FALSE;
                        END;
                    END;

                     IF Continue THEN BEGIN
                        IF Members."Deposit Deficit" THEN BEGIN
                            msg:='Your '+LoanProduct."USSD Product Name"+' request has failed, Your deposits have a deficit.';
                            MobileLoan.Remarks:='Marked as Deposit Deficit';
                            MobileLoan.Status:=MobileLoan.Status::Failed;
                            MobileLoan.Posted:=TRUE;
                            MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                            MobileLoan.Message:=msg;
                            SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                            MobileLoan.MODIFY;
                            Continue:=FALSE;
                        END;
                    END;


                END
                ELSE IF SavAcc."Salary Through FOSA" THEN BEGIN
                    IF LoanProduct."Advantage Loan" THEN BEGIN

                        txtReturn := '';
                        MaxLoan:=GetLoanQualifiedAmount(SavAcc."No.",LoanProduct."Product ID",txtReturn);
                        //ERROR('MaxLoan %1',MaxLoan);
                        //ERROR(txtReturn);

                        IF MaxLoan > 0 THEN BEGIN
                            QualAmt := GetAdvantageLoanQualifiedLimit(SavAcc."No.",LoanProduct."Product ID",txtReturn);
                            IF MaxLoan > QualAmt THEN
                                MaxLoan := QualAmt;
                            IF MaxLoan <= 0 THEN BEGIN

                                msg:='Your '+LoanProduct."Product Description"+' request has failed, '+txtReturn;
                                MobileLoan.Remarks:=txtReturn;
                                MobileLoan.Status:=MobileLoan.Status::Failed;
                                MobileLoan.Posted:=TRUE;
                                MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                                MobileLoan.Message:=msg;
                                SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                                MobileLoan.MODIFY;
                                Continue:=FALSE;
                            END;

                        END
                        ELSE BEGIN

                            msg:='Your '+LoanProduct."Product Description"+' request has failed, '+txtReturn;
                            MobileLoan.Remarks:=txtReturn;
                            MobileLoan.Status:=MobileLoan.Status::Failed;
                            MobileLoan.Posted:=TRUE;
                            MobileLoan."Date Posted":=CURRENTDATETIME;//TODAY;
                            MobileLoan.Message:=msg;
                            SendSms(Source::MBANKING,SavAcc."Transactional Mobile No",msg,FORMAT(MobileLoan."Entry No"),'',TRUE,Priority,FALSE);
                            MobileLoan.MODIFY;
                            Continue:=FALSE;
                        END;

                    END
                    ELSE
                        MaxLoan:=GetLoanQualifiedAmount(SavAcc."No.",LoanProduct."Product ID",txtReturn);
                END
