RecoverSalariedLoanPenalty()

Loans.RESET;
//Loans.SETRANGE("Loan No.",LoanNo);
Loans.SETRANGE("Non-Salaried",FALSE);
Loans.SETRANGE("Mobile Loan",TRUE);
Loans.SETFILTER("Loan Product Type",'<>%1','416');
