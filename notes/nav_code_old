            LGCount := 1;
        REPEAT

            Response += '<Security>';
              Response += '<LoanNo>'+Loans."Loan No."+'</LoanNo>';
              Response += '<Type>'+FORMAT(LoanGuarantors."Guarantor Type")+'</Type>';
              Response += '<RemainingInstallment>'+FORMAT(RemInst)+' Month(s)</RemainingInstallment>';
