GetAccountList(PhoneNo : Text[30]) Response : Text

PhoneNo := '+'+PhoneNo;
Response:='';
Found:=FALSE;

SavAcc.RESET;
SavAcc.SETRANGE("Transactional Mobile No",PhoneNo);
SavAcc.SETFILTER(Status,'<>%1',SavAcc.Status::Deceased);
SavAcc.SETRANGE("Product Category",SavAcc."Product Category"::" ");
