AccountBalanceEnquiry(EntryCode : GUID;TransactionID : Code[20];PhoneNo : Code[20];PIN : Text;AccType : Text) Response : Text[1024]
TransactionDate := CURRENTDATETIME;

Response:='ERROR';
Found:=FALSE;


PhoneNo := '+'+PhoneNo;

 IF NOT CorrectPin(PhoneNo,PIN) THEN BEGIN
