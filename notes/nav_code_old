GetAdvantageLoanQualifiedLimit(AccountNo : Code[20];LoanProductType : Code[20];VAR txtR : Text) : Decimal


txtR := '';
SalaryQualification := 0;
DepositQualification := 0;
NetQualification:=0;
MemberNumber:='';

Salary1 := 0;
Salary2 := 0;
Salary3 := 0;

SalEnd := TODAY;
SalStart := CALCDATE('-135D', SalEnd);  // Set range to 135 days

saccoAccount.RESET;
saccoAccount.SETRANGE("No.", AccountNo);
saccoAccount.SETRANGE("Salary Through FOSA", TRUE);
IF saccoAccount.FIND('-') THEN BEGIN

  MemberNumber:= saccoAccount."Member No.";

    IF LoanType.GET(LoanProductType) THEN BEGIN

      Loans.RESET;
      Loans.SETRANGE("Member No.", MemberNumber);
      Loans.SETRANGE("Recovery Mode",Loans."Recovery Mode"::Salary);
      Loans.SETRANGE("Loan Product Type", '414');
      Loans.SETFILTER("Outstanding Balance", '>0');

      IF Loans.FINDFIRST THEN BEGIN
          txtR := 'You can only have one mobile loan at a time, kindly clear your ' + Loans."Loan Product Type Name";
          EXIT(0);
      END;


        Members.GET(saccoAccount."Member No.");
        IF Members."Next Advantage Date" <> 0D THEN BEGIN

            Rating.RESET;
            Rating.SETRANGE("Loan Product", LoanProductType);
            Rating.SETRANGE("Member No.", saccoAccount."Member No.");
            IF Rating.FINDLAST THEN
                Rating.DELETEALL;

            IF Members."Next Advantage Date" > TODAY THEN BEGIN
                txtR := 'You can only apply for this product after ' + FORMAT(Members."Next Advantage Date");
                EXIT(0);
            END ELSE BEGIN
                Members."Next Advantage Date" := 0D;
                Members."Advantage Defaulter" := FALSE;
                Members.MODIFY;
            END;
        END;


        DepAcc.RESET;
        DepAcc.SETRANGE("Member No.", saccoAccount."Member No.");
        DepAcc.SETRANGE("Product Category", DepAcc."Product Category"::"Deposit Contribution");
        IF DepAcc.FINDFIRST THEN BEGIN
            DepAcc.CALCFIELDS("Balance (LCY)");
            IF DepAcc."Balance (LCY)" < LoanType."Non-Salaried Min. Deposits" THEN BEGIN
                EXIT(0);
            END;
        END ELSE
            EXIT(0);

        DepAcc.RESET;
        DepAcc.SETRANGE("Member No.", saccoAccount."Member No.");
        DepAcc.SETRANGE("Product Category", DepAcc."Product Category"::"Share Capital");
        IF DepAcc.FINDFIRST THEN BEGIN
            DepAcc.CALCFIELDS("Balance (LCY)");
            IF DepAcc."Balance (LCY)" < LoanType."Non-Salaried Min. Share Cap" THEN BEGIN
                txtR := 'You have insufficient Share Capital';
                EXIT(0);
            END;
        END ELSE
            EXIT(0);

        MaxLoanAmount := LoanType."Maximum Loan Amount";

        CreditLimit := LoanCreditRating(saccoAccount."Member No.", LoanType."Product ID", FALSE);
        IF MaxLoanAmount > CreditLimit THEN
            MaxLoanAmount := CreditLimit;

        DepAcc.RESET;
        DepAcc.SETRANGE("Member No.", saccoAccount."Member No.");
        DepAcc.SETRANGE("Product Category", DepAcc."Product Category"::"Deposit Contribution");
        IF DepAcc.FINDFIRST THEN BEGIN
            DepAcc.CALCFIELDS("Balance (LCY)");
            DepositQualification := (10/100 * DepAcc."Balance (LCY)");
            IF MaxLoanAmount > DepositQualification THEN
                MaxLoanAmount := DepositQualification;
        END ELSE
            MaxLoanAmount := 0;

        // Checking if at least 3 salaries are processed within 135 days
        SalBuffer.RESET;
        SalBuffer.SETCURRENTKEY(SalBuffer."Member No.", SalBuffer."Posting Date");
        SalBuffer.SETRANGE(SalBuffer."Account No.", AccountNo);
        SalBuffer.SETFILTER("Posting Date", '%1..%2', SalStart, SalEnd);
        SalBuffer.SETRANGE(Posted, TRUE);
        SalBuffer.SETRANGE("Income Type", SalBuffer."Income Type"::Salary);

        IF SalBuffer.COUNT >= 3 THEN BEGIN
            SalBuffer.FINDSET;
            SalBuffer.NEXT;
            Salary1 := SalBuffer.Amount;
            Date1 := SalBuffer."Posting Date";

            SalBuffer.NEXT;
            Salary2 := SalBuffer.Amount;
            Date2 := SalBuffer."Posting Date";

            SalBuffer.NEXT;
            Salary3 := SalBuffer.Amount;
            Date3 := SalBuffer."Posting Date";
        END ELSE BEGIN
            txtR := 'Insufficient salary entries within the past 135 days';
            EXIT(0);
        END;

        // Calculate the Net Salary using the smallest of the 3 salaries
        NetSal := Salary1;
        IF NetSal > Salary2 THEN
            NetSal := Salary2;

        IF NetSal > Salary3 THEN
            NetSal := Salary3;

        Loans.RESET;
        Loans.SETRANGE("Member No.", saccoAccount."Member No.");
        Loans.SETRANGE("Loan Product Type", LoanType."Product ID");
        Loans.SETRANGE("Mobile Loan", TRUE);
        Loans.SETFILTER("Outstanding Balance", '>0');
        IF Loans.FINDFIRST THEN BEGIN
            REPEAT
                Loans.CALCFIELDS("Outstanding Balance", "Outstanding Penalty");
                LBal := Loans."Outstanding Balance" + Loans."Outstanding Penalty";
                MaxLoanAmount -= LBal;
            UNTIL Loans.NEXT = 0;
        END;

        STODed := 0;
        StandingOrders.RESET;
        StandingOrders.SETRANGE(StandingOrders."Source Account No.", saccoAccount."No.");
        StandingOrders.SETRANGE(StandingOrders.Status, StandingOrders.Status::Approved);
        StandingOrders.SETFILTER("End Date", '>%1', TODAY);
        IF StandingOrders.FIND('-') THEN BEGIN
            REPEAT
                STODed := STODed + StandingOrders.Amount;
            UNTIL StandingOrders.NEXT = 0;
        END;


        MESSAGE('Salary 3 - %1\Date 3 - %3',Salary3,Date3);
        MESSAGE('Salary 2 - %1\Date 2 - %2',Salary2,Date2);
        MESSAGE('Salary 1 - %1\Date 1 - %1',Salary1,Date1);
        MESSAGE('Total STOs - %1',STODed);
        MESSAGE('Total Loans - %1',LBal);


        IF MaxLoanAmount < 0 THEN
            MaxLoanAmount := 0;

      NetQualification:=NetSal-(LBal + STODed);

        SalaryQualification := ((NetQualification * 60 / 100)*6);

        IF SalaryQualification > MaxLoanAmount THEN
            SalaryQualification := MaxLoanAmount
        ELSE
            MaxLoanAmount := MaxLoanAmount;

        IF SalaryQualification <= 0 THEN BEGIN
            txtR := 'Your current commitment exceeds your ability to repay';
        END ELSE BEGIN
            txtR := 'You qualify for: KSH.' + FORMAT(SalaryQualification);
        END;

        EXIT(ROUND(MaxLoanAmount, 1, '<'));
    END;
END ELSE BEGIN
    txtR := 'Your Salary does not pass through FOSA';
END;

EXIT(0);

