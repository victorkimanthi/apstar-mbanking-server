Documentation()

OnRun()

HandleRequest(Request : Text) : Text
RequestParser := RequestParser.Parse(FORMAT(Request));
RequestAction := RequestParser.SelectToken('action').ToString;
RequestPayload := RequestParser.SelectToken('payload').ToString;
RequestAPIID := RequestParser.SelectToken('api_request_id').ToString;

CASE RequestAction OF
  'GET_MEMBER_DETAILS':
    EXIT(GetMemberDetails(RequestPayload,RequestAPIID));
  'GET_DEPOSIT_ACCOUNTS':
    EXIT(GetDepositAccounts(RequestPayload,RequestAPIID));
  'VALIDATE_ACCOUNT':
    EXIT(ValidateAccount(RequestPayload,RequestAPIID));
  'BALANCE_ENQUIRY':
    EXIT(DepositBalanceEnquiry(RequestPayload,RequestAPIID));
  'ACCOUNT_MINI_STATEMENT':
    EXIT(AccountMiniStatement(RequestPayload,RequestAPIID));
  'ACCOUNT_FULL_STATEMENT':
    EXIT(AccountFullStatement(RequestPayload,RequestAPIID));
  'GET_LOAN_TYPES':
    EXIT(GetLoanTypes(RequestPayload,RequestAPIID));
  'GET_LOANS_IN_SERVICE':
    EXIT(GetLoansInService(RequestPayload,RequestAPIID));
  'LOAN_BALANCE_ENQUIRY':
    EXIT(LoanBalanceEnquiry(RequestPayload,RequestAPIID));
  'LOAN_MINI_STATEMENT':
    EXIT(LoanMiniStatement(RequestPayload,RequestAPIID));
  'LOAN_FULL_STATEMENT':
    EXIT(LoanFullStatement(RequestPayload,RequestAPIID));
  'CHECK_LOAN_LIMIT':
    EXIT(CheckLoanLimit(RequestPayload,RequestAPIID));
  'GET_CHARGES':
    EXIT(GetCharges(RequestPayload,RequestAPIID));
  'WITHDRAWAL':
    EXIT(Withdrawal(RequestPayload, RequestAPIID));
  'WITHDRAWAL_RESULT':
    EXIT(WithdrawalResult(RequestPayload, RequestAPIID));
  'DEPOSIT':
    EXIT(Deposit(RequestPayload,RequestAPIID));
  'LOAN_APPLICATION':
    EXIT(ApplyLoan(RequestPayload,RequestAPIID));
  'IFT_ACCOUNT_TO_ACCOUNT':
    EXIT(IFTAccountToAccount(RequestPayload,RequestAPIID));
  'IFT_LOAN_REPAYMENT':
    EXIT(IFTLoanRepayment(RequestPayload,RequestAPIID));
  ELSE
    EXIT(RequestActionNotValid(RequestAction));
END

LOCAL GetMemberDetails(Payload : Text;RequestAPIID : Code[150]) : Text
StringBuilder := StringBuilder.StringBuilder;
StringWriter := StringWriter.StringWriter(StringBuilder);
JsonTextWriter := JsonTextWriter.JsonTextWriter(StringWriter);

JsonObject := JsonObject.Parse(FORMAT(Payload));
IdentifierType := JsonObject.SelectToken('identifier_type').ToString;
Identifier := JsonObject.SelectToken('identifier').ToString;

JsonTextWriter.WriteStartObject;

IF MemberExists(IdentifierType,Identifier,Members,Status,Response) THEN BEGIN
    PrimaryIdentity := '';
    IF Members."ID No." <> '' THEN BEGIN
       PrimaryIdentityType := 'NATIONAL_ID';
       PrimaryIdentity := Members."ID No."
     END ELSE BEGIN
       PrimaryIdentityType :='PASSPORT_NO';
       PrimaryIdentity := Members."Passport No.";
      END;
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue(Status);
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('customer_type');
      CASE Members."Single Party/Multiple" OF
         Members."Single Party/Multiple"::Single:
            JsonTextWriter.WriteValue('INDIVIDUAL');
         Members."Single Party/Multiple"::Multiple:
            JsonTextWriter.WriteValue('REPRESENTATIVE');
         ELSE
            JsonTextWriter.WriteValue('CORPORATE');
       END;

    JsonTextWriter.WritePropertyName('identifier_type');
    JsonTextWriter.WriteValue('CUSTOMER_NO');
    JsonTextWriter.WritePropertyName('identifier');
    JsonTextWriter.WriteValue(Members."No.");
    JsonTextWriter.WritePropertyName('primary_identity_type');
    JsonTextWriter.WriteValue(PrimaryIdentityType);
    JsonTextWriter.WritePropertyName('primary_identity_no');
    JsonTextWriter.WriteValue(PrimaryIdentity);
    JsonTextWriter.WritePropertyName('title');
    JsonTextWriter.WriteValue(Members.Salutation);
    JsonTextWriter.WritePropertyName('full_name');
    JsonTextWriter.WriteValue(Members.Name);
    JsonTextWriter.WritePropertyName('gender');
    JsonTextWriter.WriteValue(FORMAT(Members.Gender));
    JsonTextWriter.WritePropertyName('date_of_birth');
    JsonTextWriter.WriteValue(FormatDate(Members."Date of Birth"));
    JsonTextWriter.WritePropertyName('primary_email_address');
    JsonTextWriter.WriteValue(Members."E-Mail");
    JsonTextWriter.WritePropertyName('primary_mobile_number');
    JsonTextWriter.WriteValue(Members."Mobile Phone No");
    JsonTextWriter.WritePropertyName('status');
    JsonTextWriter.WriteValue(FORMAT(Members.Status));
    JsonTextWriter.WritePropertyName('registration_date');
    JsonTextWriter.WriteValue(FormatDate(Members."Registration Date"));
    JsonTextWriter.WritePropertyName('tax_authority');
    JsonTextWriter.WriteValue('KRA');
    JsonTextWriter.WritePropertyName('tax_authority_pin_number');
    JsonTextWriter.WriteValue(Members."P.I.N Number");
    JsonTextWriter.WritePropertyName('branch_code');
    JsonTextWriter.WriteValue(Members."Global Dimension 2 Code");
    JsonTextWriter.WritePropertyName('branch');
    DimensionValues.RESET;
    DimensionValues.SETRANGE(Code, Members."Global Dimension 2 Code");
    IF DimensionValues.FINDFIRST THEN
      JsonTextWriter.WriteValue(DimensionValues.Name)
    ELSE
      JsonTextWriter.WriteValue(Members."Global Dimension 2 Code");

    JsonTextWriter.WritePropertyName('main_savings_account_no');
    JsonTextWriter.WriteValue(GetMemberFosaAcc(Members));
    JsonTextWriter.WriteEndObject;
  END ELSE BEGIN
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue(Status);
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('error_message');
    JsonTextWriter.WriteValue(Response);
  END;
  JsonTextWriter.WriteEndObject;
  // Close the JsonTextWriter and StringWriter

JsonTextWriter.Close();
StringWriter.Close();
EXIT(StringBuilder.ToString);

LOCAL GetDepositAccounts(Payload : Text;RequestAPIID : Code[150]) : Text
StringBuilder := StringBuilder.StringBuilder;
StringWriter := StringWriter.StringWriter(StringBuilder);
JsonTextWriter := JsonTextWriter.JsonTextWriter(StringWriter);

JsonObject := JsonObject.Parse(FORMAT(Payload));
AccountType := JsonObject.SelectToken('account_type').ToString;
IdentifierType := JsonObject.SelectToken('identifier_type').ToString;
Identifier := JsonObject.SelectToken('identifier').ToString;


JsonTextWriter.WriteStartObject;
IF MemberExists(IdentifierType,Identifier,Members,Status,Response) THEN BEGIN
  CASE AccountType OF
       'FOSA':
         ProductFact.SETRANGE("Shortcut Dimension 1 Code",'BANKING');
       'BOSA':
        ProductFact.SETRANGE("Shortcut Dimension 1 Code",'CREDIT');
       'WITHDRAWABLE':
        ProductFact.SETFILTER("Mobile Transaction",'%1|%2',ProductFact."Mobile Transaction"::"Withdrawals Only",ProductFact."Mobile Transaction"::"Deposits & Withdrawals");
       'DEPOSIT':
        ProductFact.SETRANGE("Mobile Transaction",ProductFact."Mobile Transaction"::"Deposits Only");
       'ALL':
         ProductFact.SETRANGE("Product Class Type",ProductFact."Product Class Type"::Savings);
      ELSE BEGIN
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('Account type '+AccountType+' is not valid');
        JsonTextWriter.WriteEndObject;
            JsonTextWriter.Close();
            StringWriter.Close();
        EXIT(StringBuilder.ToString);
      END;
  END;
       SavingsAccounts.RESET;
       SavingsAccounts.SETRANGE("Member No.",Members."No.");
       IF SavingsAccounts.FINDSET THEN BEGIN
          JsonTextWriter.WritePropertyName('request_status');
          JsonTextWriter.WriteValue(Status);
          JsonTextWriter.WritePropertyName('response_payload');
          JsonTextWriter.WriteStartArray;
       REPEAT
          IsWithdrawable := FALSE;
          IsDepositable := FALSE;
          ProductFact.SETRANGE("Product ID", SavingsAccounts."Product Type");
          IF ProductFact.FIND('-') THEN BEGIN
          JsonTextWriter.WriteStartObject;
          JsonTextWriter.WritePropertyName('account_name');
          JsonTextWriter.WriteValue(SavingsAccounts."Product Name");
          JsonTextWriter.WritePropertyName('account_label');
          JsonTextWriter.WriteValue(SavingsAccounts."Product Name");
          JsonTextWriter.WritePropertyName('account_number');
          JsonTextWriter.WriteValue(SavingsAccounts."No.");
          JsonTextWriter.WritePropertyName('account_type');
          JsonTextWriter.WriteValue(AccountType);
          JsonTextWriter.WritePropertyName('account_balance');
          JsonTextWriter.WriteValue(GetSavingsAccountBalance(SavingsAccounts."No."));
          JsonTextWriter.WritePropertyName('account_status');
          JsonTextWriter.WriteValue(UPPERCASE(FORMAT(SavingsAccounts.Status)));
          JsonTextWriter.WritePropertyName('can_withdraw');
          IF (ProductFact."Mobile Transaction" = ProductFact."Mobile Transaction"::"Withdrawals Only")
             OR (ProductFact."Mobile Transaction" = ProductFact."Mobile Transaction"::"Deposits & Withdrawals") THEN BEGIN
          IsWithdrawable := TRUE;
          JsonTextWriter.WriteValue('YES');
          END ELSE
          JsonTextWriter.WriteValue('NO');
          JsonTextWriter.WritePropertyName('max_withdrawable_amount');
          JsonTextWriter.WriteValue(0);
          JsonTextWriter.WritePropertyName('can_deposit');
          IF (ProductFact."Mobile Transaction" = ProductFact."Mobile Transaction"::"Deposits Only") THEN BEGIN
          IsDepositable := TRUE;
          JsonTextWriter.WriteValue('YES');
          END ELSE
          JsonTextWriter.WriteValue('NO');

          JsonTextWriter.WritePropertyName('can_deposit_ift');
          IF (ProductFact."Mobile Transaction" = ProductFact."Mobile Transaction"::"Deposits Only") THEN BEGIN
          IsDepositable := TRUE;
          JsonTextWriter.WriteValue('YES');
          END ELSE
          JsonTextWriter.WriteValue('NO');


          JsonTextWriter.WritePropertyName('can_withdraw_ift');
          IF (ProductFact."Mobile Transaction" = ProductFact."Mobile Transaction"::"Deposits & Withdrawals"  ) THEN BEGIN
          IsDepositable := TRUE;
          JsonTextWriter.WriteValue('YES');
          END ELSE
          JsonTextWriter.WriteValue('NO');

          JsonTextWriter.WritePropertyName('max_deposit_amount');
          JsonTextWriter.WriteValue(0);
          JsonTextWriter.WriteEndObject;
          END;
          UNTIL SavingsAccounts.NEXT = 0;
          JsonTextWriter.WriteEndArray;

          END ELSE BEGIN
            JsonTextWriter.WritePropertyName('request_status');
            JsonTextWriter.WriteValue('SUCCESS');
            JsonTextWriter.WritePropertyName('response_payload');
            JsonTextWriter.WriteStartArray;
            JsonTextWriter.WriteEndArray;
           END;

 END ELSE BEGIN
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue('ERROR');
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('error_message');
    JsonTextWriter.WriteValue(Response);
  END;
  JsonTextWriter.WriteEndObject;

JsonTextWriter.Close();
StringWriter.Close();
EXIT(StringBuilder.ToString);

