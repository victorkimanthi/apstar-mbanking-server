LOCAL ValidateMinAccountBalance(RequestedAmount : Decimal;TheSavingsAccount : Code[150];TransactionType : Text) : Boolean
TotalCost := GetTransactionCharges(TransactionType,RequestedAmount) + RequestedAmount;
EXIT(TotalCost > GetSavingsAccountBalance(TheSavingsAccount));

LOCAL CheckWithdrawalTransactionLimit(RequestedAmount : Decimal;AccountNo : Code[150];Transaction : Text;VAR Resp : Text;TransactionDate : DateTime) : Boolean
  IF Transaction = 'MPESA_WITHDRAWAL' THEN
  TransactionType:=TransactionType::"Mpesa Withdrawal";

  IF Transaction = 'BILL_PAYMENT' THEN
  TransactionType:=TransactionType::"Utility Payment";

  IF Transaction = 'AIRTIME_PURCHASE' THEN
  TransactionType:=TransactionType::Airtime;

  IF Transaction = 'BANK_TRANSFER' THEN
  TransactionType:=TransactionType::"Bank Transfer";

  CoopSetup.RESET;
  CoopSetup.SETRANGE("Transaction Type",TransactionType);
  IF CoopSetup.FINDFIRST THEN BEGIN
    IF CoopSetup."Transaction Limit" > 0 THEN BEGIN
      IF RequestedAmount > CoopSetup."Transaction Limit" THEN BEGIN
        Resp := 'Transaction amount exceeds the maximum withdrawal limit of KES ' + FORMAT(CoopSetup."Transaction Limit");
        EXIT(FALSE);
      END;
    END;

    IF CoopSetup."Daily Limit" > 0 THEN BEGIN
      Limit := CoopSetup."Daily Limit" - GetAmountTransacted(Transaction, AccountNo, DT2DATE(TransactionDate), Type::Daily);
      IF Limit < 0 THEN
        Limit := 0;
      IF Limit < RequestedAmount THEN BEGIN
        Resp := 'Transaction amount exceeds the set daily limit. You can only withdraw up to KES ' + FORMAT(Limit) + ' today.';
        EXIT(FALSE);
      END;
    END;

    IF CoopSetup."Weekly Limit" > 0 THEN BEGIN
      Limit := CoopSetup."Weekly Limit" - GetAmountTransacted(Transaction, AccountNo, DT2DATE(TransactionDate), Type::Weekly);
      IF Limit < 0 THEN
        Limit := 0;
      IF Limit < RequestedAmount THEN BEGIN
        Resp := 'Transaction amount exceeds the set weekly limit. You can only withdraw up to KES ' + FORMAT(Limit) + ' today.';
        EXIT(FALSE);
      END;
    END;

    IF CoopSetup."Monthly Limit" > 0 THEN BEGIN
      Limit := CoopSetup."Monthly Limit" - GetAmountTransacted(Transaction, AccountNo, DT2DATE(TransactionDate), Type::Monthly);
      IF Limit < 0 THEN
        Limit := 0;
      IF Limit < RequestedAmount THEN BEGIN
        Resp := 'Transaction amount exceeds the set monthly limit. You can only withdraw up to KES ' + FORMAT(Limit) + ' today.';
        EXIT(FALSE);
      END;
    END;
  END;
  EXIT(TRUE);

GetAmountTransacted(Transaction : Text;AccountNo : Code[20];Date : Date;Type : 'Daily,Weekly,Monthly') Amt : Decimal
 Amt := 0;
 IF Transaction = 'MPESA_WITHDRAWAL' THEN
  TransactionType:='Withdrawal Request';

  IF Transaction = 'BILL_PAYMENT' THEN
  TransactionType:='Utility Request';

  IF Transaction = 'AIRTIME_PURCHASE' THEN
  TransactionType:='Airtime Request';

  IF Transaction = 'BANK_TRANSFER' THEN
   TransactionType:='Bank Transfer Request';

 IF (TransactionType = 'Withdrawal Request') OR (TransactionType = 'Utility Request') OR (TransactionType = 'Airtime Request')  OR (TransactionType = 'Bank Transfer Request')  THEN BEGIN
    MobileWithdrawalsBuffer.RESET;
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer.Reversed,FALSE);
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer."Account No",AccountNo);
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer."Withdrawal Type",TransactionType);
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer.Source,MobileWithdrawalsBuffer.Source::"M-PESA");
    IF Type = Type::Daily THEN
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer."Transaction Date",Date);
    IF Type = Type::Weekly THEN
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer."Transaction Date",CALCDATE('-CW',Date),CALCDATE('CW',Date));
    IF Type = Type::Monthly THEN
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer."Transaction Date",CALCDATE('-CM',Date),CALCDATE('CM',Date));
    IF MobileWithdrawalsBuffer.FIND('-') THEN BEGIN
        MobileWithdrawalsBuffer.CALCSUMS(Amount);
        Amt := MobileWithdrawalsBuffer.Amount;
    END;
 END;
