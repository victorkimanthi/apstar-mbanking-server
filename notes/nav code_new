          JsonTextWriter.WritePropertyName('transaction_date_time');
          JsonTextWriter.WriteValue(FormatISODateTime(CURRENTDATETIME));
          JsonTextWriter.WriteEndObject;
          JsonTextWriter.WriteEndObject;
          JsonTextWriter.Close();
          StringWriter.Close();
          EXIT(StringBuilder.ToString);
      END;

    MobileWithdrawalsBuffer.RESET;
    MobileWithdrawalsBuffer.SETRANGE("Trace ID", OriginatorID);
    MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer.Source, MobileWithdrawalsBuffer.Source::"M-PESA");
    IF MobileWithdrawalsBuffer.FINDFIRST THEN BEGIN
        IF transaction_status = 'CONFIRMED' THEN BEGIN
            IF MobileWithdrawalsBuffer.Posted = TRUE THEN BEGIN
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('request_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('response_payload');
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('transaction_status');
                JsonTextWriter.WriteValue('DUPLICATE');
                JsonTextWriter.WritePropertyName('transaction_status_description');
                JsonTextWriter.WriteValue('Transaction with Originator ID ' + OriginatorID + ' has already been posted');
                JsonTextWriter.WritePropertyName('transaction_date_time');
                JsonTextWriter.WriteValue(FormatISODateTime(CURRENTDATETIME));
                JsonTextWriter.WriteEndObject;
                JsonTextWriter.WriteEndObject;

                JsonTextWriter.Close();
                StringWriter.Close();
                EXIT(StringBuilder.ToString);
            END ELSE BEGIN
                MobileWithdrawalsBuffer.Posted := TRUE;
                MobileWithdrawalsBuffer."Posting Date" := TODAY;
                MobileWithdrawalsBuffer.MODIFY;

                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('request_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('response_payload');
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('transaction_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('transaction_status_description');
                JsonTextWriter.WriteValue('Result processed successfully');
                JsonTextWriter.WritePropertyName('transaction_date_time');
                JsonTextWriter.WriteValue(FormatISODateTime(CURRENTDATETIME));
                JsonTextWriter.WriteEndObject;
                JsonTextWriter.WriteEndObject;

                JsonTextWriter.Close();
                StringWriter.Close();
                EXIT(StringBuilder.ToString);
            END;
        END;

        // Check if transaction_status is REVERSE_CONFIRMED
        IF transaction_status = 'REVERSE_CONFIRMED' THEN BEGIN
           MobileWithdrawalsBuffer.SETRANGE(Posted,TRUE);
           MobileWithdrawalsBuffer.SETRANGE(Reversed,TRUE);
            IF MobileWithdrawalsBuffer.FINDFIRST THEN BEGIN
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('request_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('response_payload');
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('transaction_status');
                JsonTextWriter.WriteValue('ERROR');
                JsonTextWriter.WritePropertyName('transaction_status_description');
                JsonTextWriter.WriteValue('Transaction with Originator ID ' + OriginatorID + ' has already been reversed');
                JsonTextWriter.WritePropertyName('transaction_date_time');
                JsonTextWriter.WriteValue(FormatISODateTime(CURRENTDATETIME));
                JsonTextWriter.WriteEndObject;
                JsonTextWriter.WriteEndObject;

                JsonTextWriter.Close();
                StringWriter.Close();
                EXIT(StringBuilder.ToString);
            END ELSE BEGIN
                // Set reversed to true and modify the record
                MobileWithdrawalsBuffer.RESET;
                MobileWithdrawalsBuffer.SETRANGE("Trace ID", OriginatorID);
                MobileWithdrawalsBuffer.SETRANGE(MobileWithdrawalsBuffer.Source, MobileWithdrawalsBuffer.Source::"M-PESA");
                MobileWithdrawalsBuffer.SETRANGE(Posted,FALSE);
                MobileWithdrawalsBuffer.SETRANGE(Reversed,FALSE);
             IF MobileWithdrawalsBuffer.FINDFIRST THEN BEGIN
                MobileWithdrawalsBuffer.Posted := TRUE;
                MobileWithdrawalsBuffer."Posting Date" := TODAY;
                MobileWithdrawalsBuffer.Reversed := TRUE;
                MobileWithdrawalsBuffer."Date Reversed" := TODAY;
                MobileWithdrawalsBuffer.MODIFY;

                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('request_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('response_payload');
                JsonTextWriter.WriteStartObject;
                JsonTextWriter.WritePropertyName('transaction_status');
                JsonTextWriter.WriteValue('SUCCESS');
                JsonTextWriter.WritePropertyName('transaction_status_description');
                JsonTextWriter.WriteValue('Result processed successfully');
                JsonTextWriter.WritePropertyName('transaction_date_time');
                JsonTextWriter.WriteValue(FormatISODateTime(CURRENTDATETIME));
                JsonTextWriter.WriteEndObject;
                JsonTextWriter.WriteEndObject;

                JsonTextWriter.Close();
                StringWriter.Close();
                EXIT(StringBuilder.ToString);
            END;
        END;
      END
    END ELSE BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
