LOCAL AccountMiniStatement(Payload : Text;RequestAPIID : Code[150]) : Text
StringBuilder := StringBuilder.StringBuilder;
StringWriter := StringWriter.StringWriter(StringBuilder);
JsonTextWriter := JsonTextWriter.JsonTextWriter(StringWriter);

JsonObject := JsonObject.Parse(FORMAT(Payload));
AccountNumber := JsonObject.SelectToken('account_number').ToString;
IdentifierType := JsonObject.SelectToken('identifier_type').ToString;
Identifier := JsonObject.SelectToken('identifier').ToString;
Number_of_Transactions_str := JsonObject.SelectToken('number_of_transactions').ToString;
Count := 0;
EVALUATE(Number_of_Transactions,Number_of_Transactions_str);
JsonTextWriter.WriteStartObject;
IF MemberExists(IdentifierType,Identifier,Members,Status,Response) THEN BEGIN
  SavingsAccounts.RESET;
  SavingsAccounts.SETRANGE("Member No.",Members."No.");
  SavingsAccounts.SETRANGE("No.",AccountNumber);
  IF SavingsAccounts.FINDFIRST THEN BEGIN
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue(Status);
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('account_name');
    JsonTextWriter.WriteValue(SavingsAccounts."Product Name");
    JsonTextWriter.WritePropertyName('account_number');
    JsonTextWriter.WriteValue(SavingsAccounts."No.");
    JsonTextWriter.WritePropertyName('available_balance');
    JsonTextWriter.WriteValue(GetSavingsAccountBalance(SavingsAccounts."No."));
    JsonTextWriter.WritePropertyName('transactions');
    JsonTextWriter.WriteStartArray;
    SavingsLedgerEntry.RESET;
    SavingsLedgerEntry.SETCURRENTKEY("Entry No.");
    SavingsLedgerEntry.ASCENDING(FALSE);
    SavingsLedgerEntry.SETRANGE("Customer No.", SavingsAccounts."No.");

    IF SavingsLedgerEntry.FINDSET THEN BEGIN
        REPEAT
          Count += 1;
          JsonTextWriter.WriteStartObject;
          JsonTextWriter.WritePropertyName('transaction_reference');
          JsonTextWriter.WriteValue(SavingsLedgerEntry."Document No.");
          JsonTextWriter.WritePropertyName('transaction_date');
          JsonTextWriter.WriteValue(FormatISODate(SavingsLedgerEntry."Posting Date"));
          JsonTextWriter.WritePropertyName('transaction_time');
          JsonTextWriter.WriteValue(FormatISOTime(SavingsLedgerEntry."Posting Time"));
          JsonTextWriter.WritePropertyName('transaction_amount');
          IF SavingsLedgerEntry."Amount (LCY)" < 0 THEN
           JsonTextWriter.WriteValue(ABS(SavingsLedgerEntry."Amount (LCY)")) //credit
          ELSE
          JsonTextWriter.WriteValue(SavingsLedgerEntry."Amount (LCY)"); //debit

          JsonTextWriter.WritePropertyName('running_balance');
          SavingsAccounts.CALCFIELDS("Balance (LCY)");
          AccBal := SavingsAccounts."Balance (LCY)";
          JsonTextWriter.WriteValue(AccBal);
          JsonTextWriter.WritePropertyName('transaction_description');
          JsonTextWriter.WriteValue(SavingsLedgerEntry.Description);
          JsonTextWriter.WritePropertyName('other_details');
          JsonTextWriter.WriteValue(SavingsLedgerEntry.Description);
          JsonTextWriter.WriteEndObject
       UNTIL (Count = Number_of_Transactions) OR (SavingsLedgerEntry.NEXT = 0);
       JsonTextWriter.WriteEndArray;
       END
     END ELSE BEGIN
            JsonTextWriter.WritePropertyName('request_status');
            JsonTextWriter.WriteValue('SUCCESS');
            JsonTextWriter.WritePropertyName('response_payload');
            JsonTextWriter.WriteStartArray;
            JsonTextWriter.WriteEndArray;
           END
 END ELSE BEGIN
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue('ERROR');
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('error_message');
    JsonTextWriter.WriteValue(Response);
  END;
  JsonTextWriter.WriteEndObject;

JsonTextWriter.Close();
StringWriter.Close();
EXIT(StringBuilder.ToString);

