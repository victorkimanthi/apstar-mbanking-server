 JsonTextWriter := JsonTextWriter.JsonTextWriter(StringWriter);

 JsonObject := JsonObject.Parse(FORMAT(Payload));
 IdentifierType := JsonObject.SelectToken('identifier_type').ToString;
 Identifier := JsonObject.SelectToken('identifier').ToString;
 OriginatorID := JsonObject.SelectToken('originator_id').ToString;
 LoanTypeID := JsonObject.SelectToken('loan_type_id').ToString;
 Amount_str := JsonObject.SelectToken('amount').ToString;
 SourceReference := JsonObject.SelectToken('source_reference').ToString;
 RequestApplication := JsonObject.SelectToken('request_application').ToString;
 TransactionDateTime_str := JsonObject.SelectToken('transaction_date_time').ToString;

 EVALUATE(Amount,Amount_str);
 EVALUATE(TransactionDateTime,ConvertISOToNavDateTime(TransactionDateTime_str));

  IF NOT MemberExists(IdentifierType, Identifier, Members, Status, Response) THEN BEGIN
          JsonTextWriter.WriteStartObject;
          JsonTextWriter.WritePropertyName('request_status');
          JsonTextWriter.WriteValue('ERROR');
          JsonTextWriter.WritePropertyName('response_payload');
          JsonTextWriter.WriteStartObject;
          JsonTextWriter.WritePropertyName('error_message');
          JsonTextWriter.WriteValue(Response);
          JsonTextWriter.WriteEndObject;
          JsonTextWriter.WriteEndObject;
          JsonTextWriter.Close();
          StringWriter.Close();
          EXIT(StringBuilder.ToString);
      END;


    SavingsAccounts.SETRANGE("Member No.", Members."No.");
    SavingsAccounts.SETRANGE("Product Type", '500');
    SavingsAccounts.SETFILTER(Status, '<>%1', SavingsAccounts.Status::Deceased);

    IF NOT SavingsAccounts.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('No savings account found for the member.');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Loan Product Validation
    MobileLoanProduct.RESET;
    MobileLoanProduct.SETRANGE("Product ID", LoanTypeID);
    MobileLoanProduct.SETRANGE("Mobile Loan", TRUE);
    IF NOT MobileLoanProduct.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('Loan product with ID = ' + LoanTypeID + ' NOT available for mobile application!');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Check for existing loan applications
    MobileLoans.RESET;
    MobileLoans.SETRANGE("Account No", SavingsAccounts."No.");
    MobileLoans.SETRANGE(Status, MobileLoans.Status::Pending);
    MobileLoans.SETRANGE("Loan Product Type", LoanTypeID);
    IF MobileLoans.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('Loan application already exists for this account.');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Validate Loan Amount against Member Limits
    IF GetLoanQualifiedAmount(Members."No.", LoanTypeID) < Amount THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('Loan amount exceeds the maximum limit allowed for the member.');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    IF Amount < MobileLoanProduct."Minimum Loan Amount" THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('error_message');
        JsonTextWriter.WriteValue('Loan amount is less than the minimum limit allowed for the loan product.');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

     MobileLoans.INIT;
     MobileLoans."Entry No" := 0;
     MobileLoans."Account No" := SavingsAccounts."No.";
     MobileLoans.Date := TransactionDateTime;
     MobileLoans."Requested Amount" := Amount;
     MobileLoans.Status := MobileLoans.Status::Pending;
     MobileLoans."Loan Product Type" := MobileLoanProduct."Product ID";
     MobileLoans.Amount := Amount;
     MobileLoans."Entry Code" := CREATEGUID;
     MobileLoans."Request Application" := RequestApplication;
     MobileLoans."Date Entered" := TODAY;
     MobileLoans."Time Entered" := TIME;
     MobileLoans."Telephone No" := SavingsAccounts."Transactional Mobile No";
     MobileLoans."Micro Loan" := MobileLoanProduct."Micro Loan";

     //Check for Guarantor Requirements
    MicroLoanPurpose.RESET;
    MicroLoanPurpose.SETRANGE("Loan Type", MobileLoanProduct."Product ID");
    MicroLoanPurpose.SETRANGE("Mobile Based", TRUE);
    IF MicroLoanPurpose.FINDFIRST THEN BEGIN
        IF Members.GET(Members."No.") THEN BEGIN
            IF MicroLoanPurpose."Guarantors Mandatory For" = MicroLoanPurpose."Guarantors Mandatory For"::"Non-Members" THEN
                IF (Members."Non-Member") AND (NOT Members."Group Account") THEN
                    MobileLoans."Needs Guarantors" := TRUE;

            IF MicroLoanPurpose."Guarantors Mandatory For" = MicroLoanPurpose."Guarantors Mandatory For"::Groups THEN
                IF Members."Group Account" THEN
                    MobileLoans."Needs Guarantors" := TRUE;

            IF MicroLoanPurpose."Guarantors Mandatory For" = MicroLoanPurpose."Guarantors Mandatory For"::"Members & Non-Members" THEN
                IF NOT Members."Group Account" THEN
                    MobileLoans."Needs Guarantors" := TRUE;

            IF MicroLoanPurpose."Guarantors Mandatory For" = MicroLoanPurpose."Guarantors Mandatory For"::Members THEN
                IF (NOT Members."Non-Member") AND (NOT Members."Group Account") THEN
                    MobileLoans."Needs Guarantors" := TRUE;

            IF MobileLoans."Needs Guarantors" THEN
                MobileLoans.Status := MobileLoans.Status::"Pending Guarantors";
        END;
    END;

    MobileLoans.INSERT;

    // Success Response
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue('SUCCESS');
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('transaction_reference');
    JsonTextWriter.WriteValue(SourceReference);
    JsonTextWriter.WritePropertyName('transaction_status');
    JsonTextWriter.WriteValue('SUCCESS');
    JsonTextWriter.WritePropertyName('transaction_status_description');
    JsonTextWriter.WriteValue('Loan application processed successfully.');
    JsonTextWriter.WriteEndObject;
    JsonTextWriter.WriteEndObject;
    // Close JSON writer objects
    JsonTextWriter.Close();
    StringWriter.Close();
    EXIT(StringBuilder.ToString);

LOCAL IFTAccountToAccount(Payload : Text;RequestAPIID : Code[150]) : Text
StringBuilder := StringBuilder.StringBuilder;
StringWriter := StringWriter.StringWriter(StringBuilder);
JsonTextWriter := JsonTextWriter.JsonTextWriter(StringWriter);

JsonObject := JsonObject.Parse(FORMAT(Payload));
IdentifierType := JsonObject.SelectToken('identifier_type').ToString;
Identifier := JsonObject.SelectToken('identifier').ToString;
OriginatorID := JsonObject.SelectToken('originator_id').ToString;
SourceAccount := JsonObject.SelectToken('source_account').ToString;
DestinationAccount := JsonObject.SelectToken('destination_account').ToString;
Amount_str := JsonObject.SelectToken('amount').ToString;
SourceRef := JsonObject.SelectToken('source_reference').ToString;
RequestApplication := JsonObject.SelectToken('request_application').ToString;
SourceApplication := JsonObject.SelectToken('source_application').ToString;
TransactionDescription := JsonObject.SelectToken('transaction_description').ToString;
TransactionDateTime_str := JsonObject.SelectToken('transaction_date_time').ToString;

EVALUATE(Amount,Amount_str);
EVALUATE(TransactionDateTime,ConvertISOToNavDateTime(TransactionDateTime_str));
    IF NOT MemberExists(IdentifierType, Identifier, Members, Status, Response) THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue(Response);
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;


    // Validations
    IF Amount <= 0 THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Transaction amount must be greater than zero');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    IF SourceAccount = DestinationAccount THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Source account and destination account must be different');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    //// DUPLICATE / IFT_REQUEST_EXISTS
    MpesaTrans.RESET;
    MpesaTrans.SETRANGE("Entry No.",OriginatorID);
      IF MpesaTrans.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('IFT_REQUEST_EXISTS');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('This transaction already exists. Originator ID = ' + FORMAT(MpesaTrans."Entry No."));
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;
    // Validate source account existence

    SourceSavingsAccount.RESET;
    SourceSavingsAccount.SETRANGE("No.", SourceAccount);
    IF NOT SourceSavingsAccount.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ACCOUNT_NOT_FOUND');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Source account with identifier number ' + SourceAccount + ' does not exist!');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    IF SourceSavingsAccount."Member No." <> Members."No." THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('SUCCESS');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ACCOUNT_NOT_FOUND');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Account with identifier number ' + SourceAccount + ' does NOT belong to the given member');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;
    // Check if the account is withdrawable
    SavingsProduct.RESET;
    SavingsProduct.SETRANGE("Product ID", SourceSavingsAccount."Product Type");
    IF SavingsProduct.FINDFIRST THEN BEGIN
        IF (SavingsProduct."Mobile Transaction" = SavingsProduct."Mobile Transaction"::" ") AND
           (SavingsProduct."Mobile Transaction" <> SavingsProduct."Mobile Transaction"::"Deposits Only") THEN BEGIN
            JsonTextWriter.WriteStartObject;
            JsonTextWriter.WritePropertyName('request_status');
            JsonTextWriter.WriteValue('ERROR');
            JsonTextWriter.WritePropertyName('response_payload');
            JsonTextWriter.WriteStartObject;
            JsonTextWriter.WritePropertyName('transaction_status');
            JsonTextWriter.WriteValue('ERROR');
            JsonTextWriter.WritePropertyName('transaction_status_description');
            JsonTextWriter.WriteValue('Source account with identifier number ' + SourceAccount + ' is NOT withdrawable!');
            JsonTextWriter.WriteEndObject;
            JsonTextWriter.WriteEndObject;
            JsonTextWriter.Close();
            StringWriter.Close();
            EXIT(StringBuilder.ToString);
        END;
    END;

    // Check account status
    IF NOT CheckSavingsAccStatus(SourceAccount) THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Source account with identifier number ' + SourceAccount + ' is NOT active. Current status is ' + FORMAT(SourceSavingsAccount.Status));
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Validate minimum account balance
    IF ValidateMinAccountBalance(Amount, SourceAccount,RequestAction) THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('INSUFFICIENT_BAL');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Account has insufficient balance to complete the transaction.');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Validate destination account
    DestinationSavingsAccount.RESET;
    DestinationSavingsAccount.SETRANGE("No.", DestinationAccount);
    IF NOT DestinationSavingsAccount.FINDFIRST THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('ACCOUNT_NOT_FOUND');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Destination account with identifier number ' + DestinationAccount + ' does not exist!');
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    // Check if the destination account allows deposits
    SavingsProduct.RESET;
    SavingsProduct.SETRANGE("Product ID", DestinationSavingsAccount."Product Type");
    IF SavingsProduct.FINDFIRST THEN BEGIN
        IF NOT (SavingsProduct."Allowed Transaction" = SavingsProduct."Allowed Transaction"::"Deposit only")
           OR (SavingsProduct."Allowed Transaction" = SavingsProduct."Allowed Transaction"::"Withdraw & Deposit")THEN BEGIN
            JsonTextWriter.WriteStartObject;
            JsonTextWriter.WritePropertyName('request_status');
            JsonTextWriter.WriteValue('ERROR');
            JsonTextWriter.WritePropertyName('response_payload');
            JsonTextWriter.WriteStartObject;
            JsonTextWriter.WritePropertyName('transaction_status');
            JsonTextWriter.WriteValue('ERROR');
            JsonTextWriter.WritePropertyName('transaction_status_description');
            JsonTextWriter.WriteValue('Destination account with identifier number ' + DestinationAccount + ' does NOT allow deposits!');
            JsonTextWriter.WriteEndObject;
            JsonTextWriter.WriteEndObject;
            JsonTextWriter.Close();
            StringWriter.Close();
            EXIT(StringBuilder.ToString);
        END;
    END;

    // Check status of the destination account
    IF NOT CheckSavingsAccStatus(DestinationAccount) THEN BEGIN
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('request_status');
        JsonTextWriter.WriteValue('ERROR');
        JsonTextWriter.WritePropertyName('response_payload');
        JsonTextWriter.WriteStartObject;
        JsonTextWriter.WritePropertyName('transaction_status');
        JsonTextWriter.WriteValue('DEST_ACCOUNT_NOT_ACTIVE');
        JsonTextWriter.WritePropertyName('transaction_status_description');
        JsonTextWriter.WriteValue('Destination account with identifier number ' + DestinationAccount + ' is NOT active. Current status is ' + FORMAT(DestinationSavingsAccount.Status));
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.WriteEndObject;
        JsonTextWriter.Close();
        StringWriter.Close();
        EXIT(StringBuilder.ToString);
    END;

    MpesaTrans.RESET;
    MpesaTrans.INIT;
    MpesaTrans."Entry No." := OriginatorID;
    MpesaTrans."Date Posted":= DT2DATE(CURRENTDATETIME);
    MpesaTrans."Time Posted" := DT2TIME(CURRENTDATETIME);
    MpesaTrans."Transaction Date" := DT2DATE(TransactionDateTime);
    MpesaTrans."Transaction Time" := DT2TIME(TransactionDateTime);
    MpesaTrans."Member Account":= SourceSavingsAccount."No.";
    MpesaTrans.Description := COPYSTR(TransactionDescription,1,50);
    MpesaTrans.Amount := Amount;
    MpesaTrans."Transaction Type":= MpesaTrans."Transaction Type"::"Account Transfer";
    MpesaTrans."Transaction Name" := FORMAT(MpesaTrans."Transaction Type"::"Account Transfer");
    MpesaTrans."Account to Check" := DestinationAccount;
    MpesaTrans."Source Application" := SourceApplication;
    MpesaTrans."Request Application" := RequestApplication;
    MpesaTrans."Session ID" := SourceRef;
    MpesaTrans."Transaction ID" := SourceRef;

    MpesaTrans.INSERT;

    // Success Response
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('request_status');
    JsonTextWriter.WriteValue('SUCCESS');
    JsonTextWriter.WritePropertyName('response_payload');
    JsonTextWriter.WriteStartObject;
    JsonTextWriter.WritePropertyName('transaction_reference');
    JsonTextWriter.WriteValue(SourceRef);
    JsonTextWriter.WritePropertyName('transaction_status');
    JsonTextWriter.WriteValue('SUCCESS');
    JsonTextWriter.WritePropertyName('transaction_status_description');
    JsonTextWriter.WriteValue('Internal Funds Transfer request received successfully');
    JsonTextWriter.WriteEndObject;
    JsonTextWriter.WriteEndObject;
    JsonTextWriter.Close();
    StringWriter.Close();
    EXIT(StringBuilder.ToString);

