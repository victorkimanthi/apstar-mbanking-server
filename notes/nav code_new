LOCAL FormatDate(RealDate : Date) DateText : Text

 IF RealDate <> 0D THEN BEGIN
    Day := DATE2DMY(RealDate,1);
    Month := DATE2DMY(RealDate,2);
    Year := DATE2DMY(RealDate,3);

    // Format the day and month to always have two digits
    IF Day < 10 THEN
      FormattedDay := '0' + FORMAT(Day)
    ELSE
      FormattedDay := FORMAT(Day);

    IF Month < 10 THEN
      FormattedMonth := '0' + FORMAT(Month)
    ELSE
      FormattedMonth := FORMAT(Month);

    DateText := FormattedDay + '/' + FormattedMonth + '/' + FORMAT(Year);
  END ELSE
    DateText := '';

  EXIT(DateText);

LOCAL FormatISODate(RealDate : Date) : Text
  IF RealDate <> 0D THEN BEGIN
    Day := DATE2DMY(RealDate,1);
    Month := DATE2DMY(RealDate,2);
    Year := DATE2DMY(RealDate,3);
    IF Day < 10 THEN
      FormattedDay := '0' + FORMAT(Day)
    ELSE
      FormattedDay := FORMAT(Day);

    IF Month < 10 THEN
      FormattedMonth := '0' + FORMAT(Month)
    ELSE
      FormattedMonth := FORMAT(Month);

    EXIT(FORMAT(Year) + '-' + FormattedMonth + '-' + FormattedDay);
  END ELSE
    EXIT('');

LOCAL FormatISOTime(RealTime : Time) : Text
IF RealTime <> 0T THEN BEGIN
     TzDuration := 0; // GMT
     RealTime := RealTime + TzDuration;

      Hours := TzDuration DIV (60 * 60 * 1000);
      Minutes := (TzDuration DIV (60 * 1000)) MOD 60;
      Seconds := (TzDuration DIV 1000) MOD 60;


    IF Hours < 10 THEN
      FormattedHour := '0' + FORMAT(Hours)
    ELSE
      FormattedHour := FORMAT(Hours);

    IF Minutes < 10 THEN
      FormattedMinute := '0' + FORMAT(Minutes)
    ELSE
      FormattedMinute := FORMAT(Minutes);

    IF Seconds < 10 THEN
      FormattedSecond := '0' + FORMAT(Seconds)
    ELSE
      FormattedSecond := FORMAT(Seconds);

    EXIT(FormattedHour + ':' + FormattedMinute + ':' + FormattedSecond);
  END ELSE
    EXIT('00:00:00');

